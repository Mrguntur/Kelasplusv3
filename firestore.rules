
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function activeUser() {
      return hasUserProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Users can read only their own profile.
    match /users/{uid} {
      allow read: if signedIn()
        && request.auth.uid == uid
        && activeUser();
      allow create, update, delete: if false;
    }

    // Only active users with approved roles can read school records.
    // All client writes remain blocked.
    match /{collection}/{document=**} {
      allow read: if collection != 'users'
        && collection != 'userCredentials'
        && collection != 'sessions'
        && activeUser()
        && role() in ['ADMIN', 'LEADER', 'TEACHER'];
      allow write: if false;
    }
  }
}
