generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SchoolRole {
  SCHOOL_ADMIN
  SCHOOL_LEADER
  TEACHER
  SCHOOL_OPERATOR
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model School {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique @db.VarChar(80)
  name        String            @db.VarChar(200)
  status      SchoolStatus      @default(PENDING)
  timezone    String            @default("Asia/Makassar") @db.VarChar(80)
  locale      String            @default("id-ID") @db.VarChar(20)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships SchoolMembership[]
  activeSessions Session[] @relation("SessionActiveSchool")
  adminInvitations SchoolAdminInvitation[]
  academicYears AcademicYear[]
  staffProfiles StaffProfile[]
  students Student[]
  schoolClasses SchoolClass[]
  enrollments ClassEnrollment[]
  subjects Subject[]
  attendanceSessions AttendanceSession[]
  attendanceRecords AttendanceRecord[]
  teachingJournals TeachingJournal[]
  assessments Assessment[]
  assessmentScores AssessmentScore[]
  @@map("schools")
}

model User {
  id             String             @id @default(uuid()) @db.Uuid
  email          String             @unique @db.VarChar(320)
  displayName    String             @map("display_name") @db.VarChar(200)
  status         UserStatus         @default(INVITED)
  passwordHash   String?            @map("password_hash") @db.VarChar(255)
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?           @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    SchoolMembership[]
  sessions       Session[]
  staffProfiles StaffProfile[]
  attendanceRecords AttendanceRecord[]
  teachingJournals TeachingJournal[]
  assessments Assessment[]
  assessmentScores AssessmentScore[]

  @@map("users")
}

model SchoolMembership {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      SchoolRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([userId, schoolId])
  @@index([schoolId, role])
  @@map("school_memberships")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  activeSchoolId String?   @map("active_school_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deviceLabel   String?   @map("device_label") @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchool  School?   @relation("SessionActiveSchool", fields: [activeSchoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([activeSchoolId])
  @@map("sessions")
}


model SchoolRegistrationRequest {
  id             String             @id @default(uuid()) @db.Uuid
  schoolName     String             @map("school_name") @db.VarChar(200)
  requestedSlug  String             @map("requested_slug") @db.VarChar(80)
  contactName    String             @map("contact_name") @db.VarChar(200)
  email          String             @db.VarChar(320)
  phone          String?            @db.VarChar(40)
  status         RegistrationStatus @default(PENDING)
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("school_registration_requests")
}


model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  outcome     String   @db.VarChar(20)
  requestId   String?  @map("request_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(200)
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt])
  @@index([schoolId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}


model SchoolAdminInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  email       String    @db.VarChar(320)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, email, createdAt])
  @@index([expiresAt])
  @@map("school_admin_invitations")
}


enum AcademicYearStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model AcademicYear {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  name      String            @db.VarChar(40)
  startDate DateTime          @map("start_date") @db.Date
  endDate   DateTime          @map("end_date") @db.Date
  status    AcademicYearStatus @default(PLANNED)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms     Term[]
  schoolClasses SchoolClass[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, status, startDate])
  @@map("academic_years")
}

model Term {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  name           String       @db.VarChar(80)
  sequence       Int
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  academicYear   AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, sequence])
  @@index([schoolId, academicYearId])
  @@map("terms")
}


enum StaffProfileStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  INACTIVE
}

enum SchoolClassStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

enum AttendanceSessionStatus {
  DRAFT
  OPEN
  FINALIZED
}

enum AttendanceStatus {
  PRESENT
  LATE
  SICK
  EXCUSED
  ABSENT
}

enum TeachingJournalStatus {
  DRAFT
  SUBMITTED
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model StaffProfile {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  employeeNumber String?           @map("employee_number") @db.VarChar(60)
  displayName    String            @map("display_name") @db.VarChar(200)
  status         StaffProfileStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  homeroomClasses SchoolClass[]    @relation("ClassHomeroom")
  teachingAssignments TeachingAssignment[]
  attendanceSessions AttendanceSession[]

  @@unique([schoolId, id])
  @@unique([schoolId, userId])
  @@index([schoolId, status, displayName])
  @@map("staff_profiles")
}

model Student {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  studentNumber  String?       @map("student_number") @db.VarChar(60)
  fullName       String        @map("full_name") @db.VarChar(200)
  preferredName  String?       @map("preferred_name") @db.VarChar(100)
  birthDate      DateTime?     @map("birth_date") @db.Date
  status         StudentStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?     @map("archived_at") @db.Timestamptz(6)
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  enrollments    ClassEnrollment[]
  attendanceRecords AttendanceRecord[]
  assessmentScores AssessmentScore[]

  @@unique([schoolId, id])
  @@index([schoolId, fullName])
  @@map("students")
}

model SchoolClass {
  id                    String           @id @default(uuid()) @db.Uuid
  schoolId              String           @map("school_id") @db.Uuid
  academicYearId        String           @map("academic_year_id") @db.Uuid
  name                  String           @db.VarChar(80)
  gradeLevel            Int              @map("grade_level")
  homeroomStaffProfileId String?         @map("homeroom_staff_profile_id") @db.Uuid
  status                SchoolClassStatus @default(ACTIVE)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  school                School           @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear     @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)
  homeroomStaff         StaffProfile?    @relation("ClassHomeroom", fields: [schoolId, homeroomStaffProfileId], references: [schoolId, id], onDelete: Restrict)
  enrollments           ClassEnrollment[]
  teachingAssignments   TeachingAssignment[]
  attendanceSessions    AttendanceSession[]

  @@unique([schoolId, id])
  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId, status])
  @@map("school_classes")
}

model ClassEnrollment {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  classId     String          @map("class_id") @db.Uuid
  studentId   String          @map("student_id") @db.Uuid
  enrolledAt  DateTime        @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  leftAt      DateTime?       @map("left_at") @db.Timestamptz(6)
  status      EnrollmentStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass     @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  student     Student         @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)

  @@index([schoolId, classId, status])
  @@index([schoolId, studentId, status])
  @@map("class_enrollments")
}

model Subject {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  code      String?      @db.VarChar(40)
  name      String       @db.VarChar(120)
  status    SubjectStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assignments TeachingAssignment[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@map("subjects")
}

model TeachingAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  staffProfileId String       @map("staff_profile_id") @db.Uuid
  termId         String?      @map("term_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  schoolClass    SchoolClass  @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  subject        Subject      @relation(fields: [schoolId, subjectId], references: [schoolId, id], onDelete: Restrict)
  staffProfile   StaffProfile @relation(fields: [schoolId, staffProfileId], references: [schoolId, id], onDelete: Restrict)
  term           Term?        @relation(fields: [schoolId, termId], references: [schoolId, id], onDelete: Restrict)
  journals       TeachingJournal[]
  assessments    Assessment[]

  @@unique([schoolId, id])
  @@index([schoolId, classId, subjectId])
  @@index([schoolId, staffProfileId])
  @@map("teaching_assignments")
}

model AttendanceSession {
  id                    String                  @id @default(uuid()) @db.Uuid
  schoolId              String                  @map("school_id") @db.Uuid
  classId               String                  @map("class_id") @db.Uuid
  date                  DateTime                @db.Date
  sessionLabel          String                  @default("REGULAR") @map("session_label") @db.VarChar(40)
  status                AttendanceSessionStatus @default(DRAFT)
  takenByStaffProfileId String                  @map("taken_by_staff_profile_id") @db.Uuid
  finalizedAt           DateTime?               @map("finalized_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  schoolClass           SchoolClass             @relation(fields: [schoolId, classId], references: [schoolId, id], onDelete: Restrict)
  takenBy               StaffProfile            @relation(fields: [schoolId, takenByStaffProfileId], references: [schoolId, id], onDelete: Restrict)
  records               AttendanceRecord[]

  @@unique([schoolId, id])
  @@unique([schoolId, classId, date, sessionLabel])
  @@index([schoolId, date, status])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String           @id @default(uuid()) @db.Uuid
  schoolId            String           @map("school_id") @db.Uuid
  attendanceSessionId String           @map("attendance_session_id") @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  status              AttendanceStatus
  note                String?          @db.VarChar(500)
  recordedByUserId    String           @map("recorded_by_user_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendanceSession   AttendanceSession @relation(fields: [schoolId, attendanceSessionId], references: [schoolId, id], onDelete: Restrict)
  student             Student          @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  recordedBy          User             @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, attendanceSessionId, studentId])
  @@index([schoolId, studentId, status])
  @@map("attendance_records")
}

model TeachingJournal {
  id                  String               @id @default(uuid()) @db.Uuid
  schoolId            String               @map("school_id") @db.Uuid
  teachingAssignmentId String              @map("teaching_assignment_id") @db.Uuid
  journalDate         DateTime             @map("journal_date") @db.Date
  topic               String               @db.VarChar(250)
  learningActivity    String               @map("learning_activity") @db.Text
  reflection          String?              @db.Text
  status              TeachingJournalStatus @default(DRAFT)
  createdByUserId     String               @map("created_by_user_id") @db.Uuid
  submittedAt         DateTime?            @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment          TeachingAssignment   @relation(fields: [schoolId, teachingAssignmentId], references: [schoolId, id], onDelete: Restrict)
  createdBy           User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, id])
  @@index([schoolId, teachingAssignmentId, journalDate])
  @@map("teaching_journals")
}

model Assessment {
  id                   String           @id @default(uuid()) @db.Uuid
  schoolId             String           @map("school_id") @db.Uuid
  teachingAssignmentId String           @map("teaching_assignment_id") @db.Uuid
  title                String           @db.VarChar(200)
  assessmentType       String           @map("assessment_type") @db.VarChar(60)
  maxScore             Decimal          @map("max_score") @db.Decimal(7, 2)
  weight               Decimal?         @db.Decimal(5, 2)
  dueDate              DateTime?        @map("due_date") @db.Date
  status               AssessmentStatus @default(DRAFT)
  createdByUserId      String           @map("created_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignment           TeachingAssignment @relation(fields: [schoolId, teachingAssignmentId], references: [schoolId, id], onDelete: Restrict)
  createdBy            User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  scores               AssessmentScore[]

  @@unique([schoolId, id])
  @@index([schoolId, teachingAssignmentId, status])
  @@map("assessments")
}

model AssessmentScore {
  id              String     @id @default(uuid()) @db.Uuid
  schoolId        String     @map("school_id") @db.Uuid
  assessmentId    String     @map("assessment_id") @db.Uuid
  studentId       String     @map("student_id") @db.Uuid
  score           Decimal?   @db.Decimal(7, 2)
  feedback        String?    @db.VarChar(1000)
  enteredByUserId String     @map("entered_by_user_id") @db.Uuid
  enteredAt       DateTime   @default(now()) @map("entered_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  assessment      Assessment @relation(fields: [schoolId, assessmentId], references: [schoolId, id], onDelete: Restrict)
  student         Student    @relation(fields: [schoolId, studentId], references: [schoolId, id], onDelete: Restrict)
  enteredBy       User       @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)

  @@unique([schoolId, assessmentId, studentId])
  @@index([schoolId, studentId])
  @@map("assessment_scores")
}
