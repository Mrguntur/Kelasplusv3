generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum SchoolRole {
  SCHOOL_ADMIN
  SCHOOL_LEADER
  TEACHER
  SCHOOL_OPERATOR
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model School {
  id          String            @id @default(uuid()) @db.Uuid
  slug        String            @unique @db.VarChar(80)
  name        String            @db.VarChar(200)
  status      SchoolStatus      @default(PENDING)
  timezone    String            @default("Asia/Makassar") @db.VarChar(80)
  locale      String            @default("id-ID") @db.VarChar(20)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships SchoolMembership[]
  activeSessions Session[] @relation("SessionActiveSchool")
  adminInvitations SchoolAdminInvitation[]
  academicYears AcademicYear[]
  terms Term[]

  @@map("schools")
}

model User {
  id             String             @id @default(uuid()) @db.Uuid
  email          String             @unique @db.VarChar(320)
  displayName    String             @map("display_name") @db.VarChar(200)
  status         UserStatus         @default(INVITED)
  passwordHash   String?            @map("password_hash") @db.VarChar(255)
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime?           @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    SchoolMembership[]
  sessions       Session[]

  @@map("users")
}

model SchoolMembership {
  id        String     @id @default(uuid()) @db.Uuid
  schoolId  String     @map("school_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      SchoolRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  school    School     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([schoolId, userId])
  @@index([userId, schoolId])
  @@index([schoolId, role])
  @@map("school_memberships")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  activeSchoolId String?   @map("active_school_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(6)
  deviceLabel   String?   @map("device_label") @db.VarChar(200)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSchool  School?   @relation("SessionActiveSchool", fields: [activeSchoolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([activeSchoolId])
  @@map("sessions")
}


model SchoolRegistrationRequest {
  id             String             @id @default(uuid()) @db.Uuid
  schoolName     String             @map("school_name") @db.VarChar(200)
  requestedSlug  String             @map("requested_slug") @db.VarChar(80)
  contactName    String             @map("contact_name") @db.VarChar(200)
  email          String             @db.VarChar(320)
  phone          String?            @db.VarChar(40)
  status         RegistrationStatus @default(PENDING)
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  rejectionReason String?           @map("rejection_reason") @db.VarChar(500)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("school_registration_requests")
}


model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  schoolId    String?  @map("school_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  outcome     String   @db.VarChar(20)
  requestId   String?  @map("request_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(200)
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt])
  @@index([schoolId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}


model SchoolAdminInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  email       String    @db.VarChar(320)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, email, createdAt])
  @@index([expiresAt])
  @@map("school_admin_invitations")
}


enum AcademicYearStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

model AcademicYear {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  name      String            @db.VarChar(40)
  startDate DateTime          @map("start_date") @db.Date
  endDate   DateTime          @map("end_date") @db.Date
  status    AcademicYearStatus @default(PLANNED)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  terms     Term[]

  @@unique([schoolId, id])
  @@unique([schoolId, name])
  @@index([schoolId, status, startDate])
  @@map("academic_years")
}

model Term {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  name           String       @db.VarChar(80)
  sequence       Int
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  academicYear   AcademicYear @relation(fields: [schoolId, academicYearId], references: [schoolId, id], onDelete: Restrict)

  @@unique([schoolId, academicYearId, sequence])
  @@index([schoolId, academicYearId])
  @@map("terms")
}
